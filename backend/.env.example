DATABASE_URL=postgres://nawahouse:nawahouse@nawahouse_database:5432/nawahouse?sslmode=disable
CORS_ORIGINS=https://nawahouse.shop
PUBLIC_SITE_URL=https://nawahouse.shop

# ── Google Sheet mirror ──
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# ── Meta ──
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── TikTok ──
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# ── Snap ──
SNAP_PIXEL_ID=
SNAP_CAPI_ACCESS_TOKEN=
SNAP_TEST_EVENT_CODE=

# ── Admin dashboard (HTTP Basic Auth) ──
# Both must be set, otherwise /admin returns 503.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# ── IP intelligence : MaxMind ──
# Option A (recommended): local MMDB file. Download free GeoLite2-Country.mmdb
# from https://www.maxmind.com/en/accounts/current/geoip/downloads
# and set the absolute path inside the container (e.g. /app/geoip/GeoLite2-Country.mmdb).
MAXMIND_DB_PATH=

# Option B (fallback): paid MaxMind Web Services (GeoIP2 Precision Country).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ── IP intelligence : VPN / proxy detection ──
# Pick ONE provider:
#   - ipqualityscore  https://ipqualityscore.com/
#   - proxycheck      https://proxycheck.io/
#   - ipinfo          https://ipinfo.io/  (requires 'Standard' plan)
VPN_PROVIDER=
VPN_API_KEY=

# When true (recommended), dashboard counts only clicks from SA + non-VPN
# in all metrics. Admin can toggle "include invalid" per view.
STRICT_KSA_ONLY=true
