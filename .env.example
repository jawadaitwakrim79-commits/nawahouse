# ── MaxMind GeoLite2 (used by both geoipupdate container and backend) ──
# Account ID: the number on your MaxMind dashboard (e.g. 1429218)
GEOIPUPDATE_ACCOUNT_ID=1429218
GEOIPUPDATE_LICENSE_KEY=your_license_key_here

# ── Admin dashboard ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_something_long_and_random

# ── VPN detection (optional — pick one and add key) ──
VPN_PROVIDER=
VPN_API_KEY=
